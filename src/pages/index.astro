---
import { Image } from 'astro:assets';
import band from '../assets/band.jpg';
import cover from '../assets/eaten-by-mind.jpg';
import site from '../content/site.json';
import feed from '../content/instagram.json';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import instagramIcon from '@phosphor-icons/core/fill/instagram-logo-fill.svg?raw';
import facebookIcon from '@phosphor-icons/core/fill/facebook-logo-fill.svg?raw';
import spotifyIcon from '@phosphor-icons/core/fill/spotify-logo-fill.svg?raw';
import youtubeIcon from '@phosphor-icons/core/fill/youtube-logo-fill.svg?raw';
import playIcon from '@phosphor-icons/core/fill/play-fill.svg?raw';
import carouselIcon from '@phosphor-icons/core/fill/copy-fill.svg?raw';
import caretUpIcon from '@phosphor-icons/core/bold/caret-up-bold.svg?raw';
import appleIcon from '@phosphor-icons/core/fill/apple-logo-fill.svg?raw';
import amazonIcon from '@phosphor-icons/core/fill/amazon-logo-fill.svg?raw';
import tidalIcon from '@phosphor-icons/core/fill/tidal-logo-fill.svg?raw';
import equalizerIcon from '@phosphor-icons/core/fill/equalizer-fill.svg?raw';

const asset = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const canonical = new URL(asset('/'), Astro.site);
const socialIcons: Record<string, string> = {
  Instagram: instagramIcon,
  Facebook: facebookIcon,
  Spotify: spotifyIcon,
  YouTube: youtubeIcon,
};
const platformIcons: Record<string, string> = {
  'Apple Music': appleIcon,
  'YouTube Music': youtubeIcon,
  'Amazon Music': amazonIcon,
  Deezer: equalizerIcon,
  Tidal: tidalIcon,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#101010" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={asset('favicon-32.png')} sizes="32x32" />
    <link rel="icon" href={asset('favicon-192.png')} sizes="192x192" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(cover.src, canonical).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{site.name}</title>
    <style
      is:inline
      set:html={`@font-face{font-family:'World of Water';src:url('${asset('fonts/world-of-water.otf')}') format('opentype');font-display:swap;font-weight:400;}`}
    />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="header">
      <a class="brand" href="#top" aria-label="Autumn Lane home">
        <img
          src={asset('images/logo.png')}
          alt="Autumn Lane"
          width="800"
          height="100"
        />
      </a>
      <nav class="socials" aria-label="Find Autumn Lane">
        {site.socials.map((social) => (
          <a href={social.url} aria-label={social.label}>
            <Icon svg={socialIcons[social.label]} />
          </a>
        ))}
      </nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="release-title">
        <Image
          class="hero-photo"
          src={band}
          alt=""
          widths={[640, 1024, 1536, 2048]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          format="webp"
        />
        <div class="hero-inner">
          <div class="release-copy">
            <p class="eyebrow">RELEASED EP</p>
            <h1 id="release-title">{site.release.title}</h1>
            <a class="button" href={site.release.url}>
              {site.release.buttonLabel}
            </a>
          </div>
          <a
            class="cover"
            href={site.release.url}
            aria-label={`Listen to ${site.release.title}`}
          >
            <Image
              src={cover}
              alt={`${site.release.title} cover artwork`}
              widths={[700, 1000, 1500, 2048]}
              sizes="(max-width: 700px) 170vw, 1000px"
              loading="eager"
              format="avif"
              quality={80}
            />
          </a>
        </div>
      </section>
      <section class="section videos" aria-labelledby="videos-title">
        <div class="container">
          <h2 id="videos-title">Videos</h2>
          <div class="video-list">
            {site.videos.map((video) => (
              <figure>
                <div
                  class="video"
                  data-video-id={video.youtubeId}
                  data-title={`${site.name} — ${video.title}`}
                >
                  <a
                    class="video-launch"
                    href={`https://www.youtube.com/watch?v=${video.youtubeId}`}
                    aria-label={`Play ${video.title}`}
                  >
                    <img
                      src={`https://i.ytimg.com/vi/${video.youtubeId}/maxresdefault.jpg`}
                      alt=""
                      width="1280"
                      height="720"
                      loading="lazy"
                    />
                    <span class="play" aria-hidden="true">
                      <Icon svg={playIcon} />
                    </span>
                  </a>
                </div>
              </figure>
            ))}
          </div>
        </div>
      </section>
      <section class="section streaming" aria-labelledby="streaming-title">
        <div class="container">
          <h2 id="streaming-title">Streaming Platforms</h2>
          <div class="listen">
            <iframe
              class="spotify"
              title="Listen to Autumn Lane on Spotify"
              src={`https://open.spotify.com/embed/artist/${site.spotifyArtistId}`}
              width="100%"
              height="352"
              loading="lazy"
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            />
            <div class="platforms">
              {site.streaming.map((platform) => (
                <a class="button button-outline" href={platform.url}>
                  <Icon svg={platformIcons[platform.label]} />
                  {platform.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
      <section class="section instagram" aria-labelledby="instagram-title">
        <div class="container">
          <h2 id="instagram-title">Instagram</h2>
          <div class="instagram-grid">
            {feed.posts.map((post) => (
              <a
                href={post.permalink}
                aria-label={post.caption || 'Instagram post'}
              >
                <img
                  src={asset(post.image)}
                  alt={post.caption || 'Autumn Lane on Instagram'}
                  width="640"
                  height="640"
                  loading="lazy"
                  decoding="async"
                />
                {post.type === 'video' && (
                  <Icon svg={playIcon} class="post-video" />
                )}
                {post.type === 'carousel' && (
                  <Icon svg={carouselIcon} class="post-carousel" />
                )}
              </a>
            ))}
          </div>
          <a class="button follow" href={site.instagramUrl}>
            <Icon svg={instagramIcon} />
            Instagram
          </a>
        </div>
      </section>
    </main>
    <footer>
      <nav class="footer-socials" aria-label="Autumn Lane elsewhere">
        {site.socials.map((social) => (
          <a href={social.url} aria-label={social.label}>
            <Icon svg={socialIcons[social.label]} />
          </a>
        ))}
      </nav>
      <p>
        Copyright © {new Date().getFullYear()} {site.name}
      </p>
    </footer>
    <a class="to-top" href="#top" aria-label="Back to top">
      <Icon svg={caretUpIcon} />
    </a>
    <script>
      const toTop = document.querySelector<HTMLElement>('.to-top');
      const updateToTop = () =>
        toTop?.classList.toggle('visible', window.scrollY > 300);
      addEventListener('scroll', updateToTop, { passive: true });
      updateToTop();

      document
        .querySelectorAll<HTMLAnchorElement>('.video-launch')
        .forEach((link) => {
          link.addEventListener('click', (event) => {
            if (
              event.ctrlKey ||
              event.metaKey ||
              event.shiftKey ||
              event.altKey
            )
              return;
            const container = link.closest<HTMLElement>('[data-video-id]');
            if (!container) return;
            event.preventDefault();
            const player = document.createElement('iframe');
            player.src = `https://www.youtube-nocookie.com/embed/${container.dataset.videoId}?autoplay=1`;
            player.title = container.dataset.title || 'Autumn Lane video';
            player.allow =
              'autoplay; encrypted-media; fullscreen; picture-in-picture';
            player.allowFullscreen = true;
            container.replaceChildren(player);
            player.focus();
          });
        });
    </script>
  </body>
</html>
